-- 1. CARGA DE LIBRERÍA WINDUI
local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()

if not WindUI then
    warn("Error al cargar WindUI.")
    return
end

-- =======================================================
-- 2. REGISTRO DEL TEMA PERSONALIZADO
-- =======================================================
WindUI:AddTheme({
    Name = "MysteryTheme",
    
    -- Borde y detalles neón del botón flotante/minimizado
    Accent = Color3.fromHex("#00E5FF"), 
    
    -- Fondos de la ventana y elementos
    Background = Color3.fromHex("#121214"),
    ElementBackground = Color3.fromHex("#1A1A1E"),
    
    -- Colores de texto e ícono
    Text = Color3.fromHex("#FFFFFF"),
    Icon = Color3.fromHex("#00E5FF"),
    Placeholder = Color3.fromHex("#808080"),
})

-- =======================================================
-- 3. CREAR VENTANA PRINCIPAL
-- =======================================================
local Window = WindUI:CreateWindow({
    Title = "ERDN Premium",
    Subtitle = "By Christian - Cristian",
    Size = UDim2.fromOffset(580, 420),
    Transparent = true, 
    Theme = "MysteryTheme", 
    Folder = "MysteryHubConfig",
    
    -- Configuración optimizada del botón de minimizado
    OpenButton = {
        Title = "Open ERDN Premium",
        Enabled = true,
        CornerRadius = UDim.new(0, 10),
        StrokeThickness = 2
    }
})
